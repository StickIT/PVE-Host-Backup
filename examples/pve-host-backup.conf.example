# Configuration installee dans /etc/pve-host-backup.conf (mode 0600).
# Adapter les valeurs avant utilisation sur un autre environnement.

PVE_NFS_STORAGE="dreambox-backup"
EXPECTED_NFS_SOURCE="192.168.11.133:/volume1/Proxmox"
BACKUP_ROOT="/mnt/pve/dreambox-backup/backups/PVE/host/nukebox"
KEEP_BACKUPS="3"
MIN_FREE_KIB="5242880"
ZSTD_THREADS="2"
CPU_QUOTA_PERCENT="200"
MEMORY_HIGH="2G"
MEMORY_MAX="0"
STAGING_ROOT="/var/tmp/pve-host-restore"
MAIL_TO="root"
BACKUP_TIME="04:15"
NOTIFY_SUCCESS="0"
